              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "record_count": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "path",
            "sha256",
            "record_count"
          ],
          "additionalProperties": false
        }
      },
