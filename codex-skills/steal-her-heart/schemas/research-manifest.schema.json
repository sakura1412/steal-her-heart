            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "record_count": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "sha256",
            "record_count"
          ],
          "additionalProperties": false
        },
        "claims.jsonl": {
          "type": "object",
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "record_count": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "sha256",
            "record_count"
          ],
