{
  "type": "object",
  "properties": {
    "schema_version": {
      "enum": [
        "1.0.0",
        "1.1.0",
        "1.2.0",
        "1.3.0"
      ]
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "parent_snapshot": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "scope_version": {
      "type": "string",
      "minLength": 1
    },
    "original_request": {
      "type": "string",
      "minLength": 1
    },
    "research_objective": {
      "type": "string",
      "minLength": 1
    },
    "scope_summary": {
      "type": "string",
      "minLength": 1
    },
    "phase": {
      "enum": [
        "understanding",
        "researching",
        "validating",
        "supplementing",
        "analyzing",
        "reporting",
        "completed",
        "blocked",
        "cancelled",
        "failed"
      ]
    },
    "preferences": {
      "type": "object",
      "properties": {
        "audiences": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "value": {
                "type": "string",
                "minLength": 1
              },
              "basis": {
                "enum": [
                  "explicit_user",
                  "task_config",
                  "default"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "value",
              "basis",
              "reason"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "report_detail": {
          "type": "object",
          "properties": {
            "value": {
              "enum": [
                "简单",
                "一般",
                "详细"
              ]
            },
            "basis": {
              "enum": [
                "explicit_user",
                "task_config",
                "default"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "value",
            "basis",
            "reason"
          ],
          "additionalProperties": false
        },
        "interaction_mode": {
          "enum": [
            "interactive_async",
            "noninteractive",
            "no_async_support"
          ]
        },
        "preference_timeout_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "asked_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "deadline_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "output_format": {
          "type": "string",
          "minLength": 1
        },
        "ppt_requested": {
          "enum": [
            "not_asked",
            "pending",
            "yes",
            "no",
            "not_requested_noninteractive"
          ]
        }
      },
      "required": [
        "audiences",
        "report_detail",
        "interaction_mode",
        "preference_timeout_seconds",
        "asked_at",
        "deadline_at",
        "output_format",
        "ppt_requested"
      ],
      "additionalProperties": false
    },
    "quality_policy_version": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "Quick",
        "Standard",
        "Deep"
      ]
    },
    "budget": {
      "type": "object",
      "properties": {
        "limits": {
