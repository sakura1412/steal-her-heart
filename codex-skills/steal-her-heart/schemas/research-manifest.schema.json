        "reserved": {
          "type": "object",
          "properties": {
            "research_operations": {
              "type": "integer",
              "minimum": 0
            },
            "document_versions": {
              "type": "integer",
              "minimum": 0
            },
            "supplement_rounds": {
              "type": "integer",
              "minimum": 0
            },
            "report_repair_rounds": {
              "type": "integer",
              "minimum": 0
            },
            "global_rework_rounds": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "research_operations",
            "document_versions",
            "supplement_rounds",
            "report_repair_rounds",
            "global_rework_rounds"
