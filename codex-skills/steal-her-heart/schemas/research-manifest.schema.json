    "workflow": {
      "type": "object",
      "properties": {
        "state": {
          "enum": [
            "Interview",
            "Plan",
            "Collect",
            "Validate",
            "Analyze",
            "Report",
            "ReportQA",
            "Delivered"
          ]
        },
        "status": {
          "enum": [
            "active",
            "waiting_input",
            "blocked",
            "completed",
            "cancelled",
            "failed"
          ]
        },
        "report_qa": {
          "enum": [
            "pending",
            "passed",
            "failed"
          ]
        },
        "delivery_status": {
          "enum": [
            "not_started",
            "exporting",
            "verified",
            "failed",
            "text_only"
          ]
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "issue_id": {
                "type": "string",
                "minLength": 1
              },
              "owner": {
                "enum": [
                  "Interview",
                  "Plan",
                  "Collect",
                  "Validate",
                  "Analyze",
                  "Report",
                  "ReportQA",
                  "Delivered"
                ]
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "blocking": {
                "type": "boolean"
              }
            },
            "required": [
              "issue_id",
              "owner",
              "description",
              "blocking"
            ],
            "additionalProperties": false
          }
        },
        "last_transition": {
          "type": "object",
          "properties": {
            "from": {
              "enum": [
                null,
                "Interview",
                "Plan",
                "Collect",
                "Validate",
                "Analyze",
                "Report",
                "ReportQA",
                "Delivered"
              ]
            },
            "to": {
              "enum": [
                "Interview",
                "Plan",
                "Collect",
                "Validate",
                "Analyze",
                "Report",
                "ReportQA",
                "Delivered"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "scope_version": {
              "type": "string",
              "minLength": 1
            },
            "occurred_at": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "from",
            "to",
            "reason",
            "scope_version",
            "occurred_at"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "from": {
                    "const": null
                  }
                },
                "required": [
                  "from"
                ]
              },
              "then": {
                "properties": {
                  "to": {
                    "enum": [
                      "Interview",
                      "Plan",
                      "Analyze",
                      "Report"
                    ]
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "from": {
                    "const": "Interview"
                  }
                },
                "required": [
                  "from"
                ]
              },
              "then": {
                "properties": {
                  "to": {
                    "enum": [
                      "Interview",
                      "Plan"
                    ]
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "from": {
                    "const": "Plan"
                  }
                },
                "required": [
                  "from"
                ]
              },
              "then": {
                "properties": {
                  "to": {
                    "enum": [
                      "Plan",
                      "Collect"
                    ]
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "from": {
                    "const": "Collect"
                  }
                },
                "required": [
                  "from"
                ]
              },
              "then": {
                "properties": {
                  "to": {
                    "enum": [
                      "Collect",
                      "Validate"
                    ]
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "from": {
                    "const": "Validate"
                  }
                },
                "required": [
                  "from"
                ]
              },
              "then": {
                "properties": {
                  "to": {
                    "enum": [
                      "Validate",
                      "Plan",
                      "Collect",
                      "Analyze",
                      "Report"
                    ]
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "from": {
                    "const": "Analyze"
                  }
                },
                "required": [
                  "from"
                ]
              },
              "then": {
                "properties": {
                  "to": {
                    "enum": [
                      "Analyze",
                      "Plan",
                      "Report"
                    ]
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "from": {
                    "const": "Report"
                  }
                },
                "required": [
                  "from"
                ]
              },
              "then": {
                "properties": {
                  "to": {
                    "enum": [
                      "Report",
                      "ReportQA"
                    ]
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "from": {
                    "const": "ReportQA"
                  }
                },
                "required": [
                  "from"
                ]
              },
              "then": {
                "properties": {
                  "to": {
                    "enum": [
                      "ReportQA",
                      "Report",
                      "Analyze",
                      "Validate",
                      "Plan",
                      "Delivered"
                    ]
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "from": {
                    "const": "Delivered"
                  }
                },
                "required": [
                  "from"
                ]
              },
              "then": {
                "properties": {
                  "to": {
                    "enum": [
                      "Delivered",
                      "Report",
                      "Validate"
                    ]
                  }
                }
              }
            }
          ]
        }
