  "required": [
    "schema_version",
    "snapshot_id",
    "parent_snapshot",
    "created_at",
    "scope_version",
    "original_request",
    "research_objective",
    "scope_summary",
    "phase",
    "preferences",
    "quality_policy_version",
    "mode",
    "budget",
    "qa",
    "next_actions",
    "ledger_files"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:steal-her-heart:research-manifest:1.3.0",
  "title": "Immutable research checkpoint manifest",
  "allOf": [
    {
      "if": {
        "required": [
          "background_file"
        ]
      },
      "then": {
        "properties": {
          "schema_version": {
            "enum": [
              "1.1.0",
              "1.2.0",
              "1.3.0"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "enum": [
              "1.2.0",
              "1.3.0"
            ]
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "required": [
          "workflow"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "workflow": {}
        },
        "required": [
          "workflow"
        ]
      },
      "then": {
        "properties": {
          "schema_version": {
            "enum": [
              "1.2.0",
              "1.3.0"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "workflow": {
            "properties": {
              "state": {
                "const": "Delivered"
              }
            },
            "required": [
              "state"
            ]
          }
        },
        "required": [
          "workflow"
        ]
      },
      "then": {
        "properties": {
          "workflow": {
            "properties": {
              "report_qa": {
                "const": "passed"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "workflow": {
            "properties": {
              "status": {
                "const": "completed"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "workflow"
        ]
      },
      "then": {
        "properties": {
          "workflow": {
            "properties": {
              "state": {
                "const": "Delivered"
              },
              "report_qa": {
                "const": "passed"
              },
              "delivery_status": {
                "const": "verified"
              },
              "issues": {
                "maxItems": 0
              }
            }
          },
          "phase": {
            "const": "completed"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "enum": [
              "1.2.0",
              "1.3.0"
            ]
          },
          "phase": {
            "const": "completed"
          }
        },
        "required": [
          "schema_version",
          "phase"
        ]
      },
      "then": {
        "properties": {
          "workflow": {
            "properties": {
              "status": {
                "const": "completed"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "workflow": {
            "properties": {
              "status": {
                "const": "blocked"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "workflow"
        ]
      },
      "then": {
        "properties": {
          "phase": {
            "const": "blocked"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "workflow": {
            "properties": {
              "status": {
                "const": "failed"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "workflow"
        ]
      },
      "then": {
        "properties": {
          "phase": {
            "const": "failed"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "workflow": {
            "properties": {
              "status": {
                "const": "cancelled"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "workflow"
        ]
      },
      "then": {
        "properties": {
          "phase": {
            "const": "cancelled"
          }
        }
