            "research_operations": {
              "type": "integer",
              "minimum": 0
            },
            "document_versions": {
              "type": "integer",
              "minimum": 0
            },
            "supplement_rounds": {
              "type": "integer",
              "minimum": 0
            },
            "report_repair_rounds": {
              "type": "integer",
              "minimum": 0
            },
            "global_rework_rounds": {
