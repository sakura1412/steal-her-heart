    {
      "id": "g2",
      "label": "G2产品评价公开入口",
      "source_type": "user_review",
      "entry_url": "https://www.g2.com/",
      "discovery_hint": "先核对实际产品评价页与产品身份；按日期、星级及公开角色／规模信息分层记录。",
